# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional API key for Resend email service to send live email notifications.
# If omitted or not set, order email notifications will run in safe Demo Mode and be logged on the server.
RESEND_API_KEY=""

# ORDER_NOTIFICATION_EMAIL: Recipient email for new order notifications.
ORDER_NOTIFICATION_EMAIL="tiktokpakitanmedia344@gmail.com"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive storefront map.
VITE_GOOGLE_MAPS_API_KEY=""
